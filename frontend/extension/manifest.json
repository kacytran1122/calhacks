{
  "manifest_version": 3,
  "name": "S’mile Trip Planner",
  "version": "1.6.2",
  "description": "Plan the fastest route and clear alternatives to the collegiate hackathon page you are viewing.",
  "homepage_url": "https://smilefromhereto.work/landing",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Plan this hackathon trip with S’mile",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "background": { "service_worker": "dist/background.js" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://smilefromhereto.work/*"],
  "content_scripts": [
    {
      "matches": ["https://www.mlh.com/seasons/*/events*", "https://mlh.io/seasons/*/events*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
