{
  "name": "@smile/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": ["src"],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "scout": "tsx scripts/scout.ts",
    "discover": "tsx scripts/discover.ts",
    "setup:check": "tsx scripts/setup.ts",
    "photon": "tsx photon/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:backend && npm run test:agents",
    "test:backend": "tsx --test ../tests/backend/*.test.ts",
    "test:agents": "tsx --test ../tests/agents/*.test.ts",
    "test:system": "tsx ../tests/system/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@photon-ai/api": "^0.6.0",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
