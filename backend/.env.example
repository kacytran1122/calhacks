# Copy to .env at the repo root. Never commit .env.
# Everything is optional: without a key the matching agent reports "source unavailable" instead of faking data.

# Claude — explanations, receipt/event extraction, defending decisions to the auditor, and the @smile concierge
ANTHROPIC_API_KEY=
# With a key, @smile in a private iMessage chat is a Claude agent that picks its tools. Set to "off" to keep the rule-based planner.
SMILE_CONCIERGE=

# Bright Data — live public web (event pages, fares, nearby stops). $300 hackathon credit.
BRIGHTDATA_API_TOKEN=
# Optional zone names. Empty values are discovered from the active APIs on your account.
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
# Optional override. When empty, S'mile uses Bright Data's current public Google Flights scraper ID.
BRIGHTDATA_GOOGLE_FLIGHTS_DATASET_ID=

# Who the app sends to api.weather.gov (NWS asks for a contact in the User-Agent)
NWS_CONTACT=smile-hackathon@example.com

# TigerData (Timescale cloud Postgres) — stores a timestamped snapshot of every event each search finds,
# so S'mile can flag "date moved / venue changed since you last looked". Empty = local file (.data/events.db).
# Create a free service from https://mlh.link/tigerdata-quickstart, then copy its Postgres connection string.
TIGER_DATABASE_URL=
TIGER_DATABASE_CA_PEM=
TIGER_DATABASE_CA_FILE=
TOUR_CONTRIBUTION_STORAGE=

# Visa Acceptance sandbox — signed test-card authorization with capture disabled.
VA_MERCHANT_ID=
VA_MERCHANT_KEY_ID=
VA_MERCHANT_SECRET_KEY=
VA_TEST_CARD_NUMBER=
VA_TEST_CARD_EXPIRATION_MONTH=
VA_TEST_CARD_EXPIRATION_YEAR=
VA_TEST_CARD_SECURITY_CODE=

# Photon 2.0 Beta — private one-to-one iMessage transport for the @smile agent.
# Create a project and project-scoped server key at https://app.beta.photon.codes/.
# The key must allow the message transport plus platforms:read and platforms:write for shared-line assignments.
# Keep PHOTON_API_KEY server-side and set it on both the persistent web service and the Photon worker.
# Never use the older Spectrum project-secret variables with this Beta integration.
PHOTON_PROJECT_ID=pho_prj_
PHOTON_API_KEY=pho_sk_
# Optional API override for local tests; production uses https://api.photon.codes.
PHOTON_API_ORIGIN=
# Public HTTPS origin of the Next.js app, with no trailing slash.
SMILE_WEB_URL=
# Generate a long random value and set the same value on the web app and Photon worker.
PHOTON_BRIDGE_SECRET=
# Optional durable cursor file. On Render, point this at a persistent disk.
PHOTON_CURSOR_FILE=.data/photon-cursor.json

# Scheduler — `npm run scheduler` wakes the agents every N minutes (default 5).
SCHEDULER_INTERVAL_MINUTES=
# Lets a cron service call GET /api/scheduler/run with "Authorization: Bearer <secret>". Use at least 16 random characters.
CRON_SECRET=
